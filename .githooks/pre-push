#!/bin/sh
# Every relative Markdown link and fragment resolves, and every card reference
# names an existing card, before the push leaves the machine — the same checks
# as ci.yml's docs job (METHODOLOGY.md §2).
# Enabled per clone by: git config core.hooksPath .githooks
# Without lychee installed its half is waved through; CI still checks.
st=0
scripts/check-cards.sh || st=1
if command -v lychee >/dev/null 2>&1; then
  lychee --offline --include-fragments --no-progress . || st=1
else
  echo "pre-push: lychee not installed, link check left to CI" >&2
fi
exit $st
