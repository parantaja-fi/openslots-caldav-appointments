# Radicale on localhost — and the template for a new backend.
#
# Checked in deliberately. The password below reaches a server bound to the
# loopback interface holding nothing but test events, and CI starts a fresh
# Radicale from exactly this file; it is in the same category as the throwaway
# SIGNING_KEY_JWK in vitest.config.ts. Every other backend's profile is
# gitignored and lives in a GitHub secret instead — see README.md.
#
# Set every key, empty where unused: an empty username selects
# GOOGLE_SERVICE_ACCOUNT_JSON, and being explicit stops a stale .dev.vars
# leaking into a run.

AVAILABILITY_CALENDAR_URL = "http://localhost:5232/booking/availability-test/"
BOOKING_STORE_URL         = "http://localhost:5232/booking/bookings-test/"

AVAILABILITY_USERNAME  = "booking"
AVAILABILITY_PASSWORD  = "dev-only-not-a-secret"
BOOKING_STORE_USERNAME = "booking"
BOOKING_STORE_PASSWORD = "dev-only-not-a-secret"

GOOGLE_SERVICE_ACCOUNT_JSON = ""

# The fixture paints the OPEN events the live tests read. Separate from the
# Worker's own credentials on purpose: the availability role stays read-only.
TEST_WRITE_USERNAME = "booking"
TEST_WRITE_PASSWORD = "dev-only-not-a-secret"
