# Copy to .dev.vars (gitignored) and fill in. In production these are
# `wrangler secret put` values. The calendar URLs come from wrangler.toml, which
# points at a local Radicale; add AVAILABILITY_CALENDAR_URL and BOOKING_STORE_URL
# here to point `wrangler dev` at another backend instead.
#
# This file serves `wrangler dev` and the browser e2e test. The live CalDAV
# suite reads a backend profile instead (worker/test/backends/, see README.md),
# which overrides everything here.

# CalDAV credentials, per logical calendar role. A username selects HTTP
# Basic; leave both unset to use GOOGLE_SERVICE_ACCOUNT_JSON instead.
AVAILABILITY_USERNAME  = "booking"
AVAILABILITY_PASSWORD  = ""
BOOKING_STORE_USERNAME = "booking"
BOOKING_STORE_PASSWORD = ""

# Google: the whole service-account JSON on one line. Note that the calendar
# ID must be URL-encoded inside the calendar URL in wrangler.toml.
# GOOGLE_SERVICE_ACCOUNT_JSON = '{"type":"service_account",...}'

# Grant-signing key: a private P-256 JWK on one line, from `npm run keygen`.
# Rotating it invalidates outstanding create-grants and cancellation links.
SIGNING_KEY_JWK = '{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"..."}'

# Brevo transactional API key. Left unset, the Worker sends no mail at all and
# says so in the booking response. Filling it in makes every booking under
# `wrangler dev` — including each `npm run e2e` — send real mail; the rest of
# the email settings are in wrangler.toml. The test suites use only recipient
# addresses at a domain the author controls, so a live key cannot make them
# bounce mail off strangers; point SENDER_EMAIL and the e2e address at your own
# domain before doing the same.
# BREVO_API_KEY = "xkeysib-..."

# Write credentials for the *test fixture* only, which paints the OPEN events
# the live tests need. Separate from the Worker's own credentials on purpose:
# the availability role must stay read-only.
TEST_WRITE_USERNAME = "booking"
TEST_WRITE_PASSWORD = ""
